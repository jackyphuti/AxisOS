# ==============================================================================
# Pure C Repository Language Classification (GitHub Linguist)
# ==============================================================================

# By default, treat non-C files as vendored & non-detectable for language statistics
* -text
* linguist-vendored
* linguist-detectable=false

# Pure C headers and source code are the ONLY detectable language in AxisOS
*.c text eol=lf linguist-vendored=false linguist-detectable=true
*.h text eol=lf linguist-vendored=false linguist-detectable=true
os-build/updater/axis-update binary

