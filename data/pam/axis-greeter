#%PAM-1.0
# AxisOS LiquidNodes Greeter & Lock Screen PAM Configuration
# Dynamic biometrics (Infrared Iris scan via axis-biometrics/Howdy, Fingerprint via fprintd)
# with optional passwordless screen unlock and standard password fallback.

auth      requisite pam_nologin.so

# Optional Iris / Facial / Fingerprint biometric authentication
-auth     [success=done default=ignore] pam_exec.so quiet /usr/local/bin/axis-biometrics pam-verify-iris
-auth     [success=done default=ignore] pam_howdy.so
-auth     [success=done default=ignore] pam_fprintd.so

# Standard authentication stack
@include  common-auth
@include  common-account
@include  common-session
@include  common-password
