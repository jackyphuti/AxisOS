#!/bin/sh
# AxisOS Settings wrapper — delegates execution to axisos-settings-panel / settings.py
if [ -x /usr/local/bin/axisos-settings-panel ]; then
    exec /usr/local/bin/axisos-settings-panel "$@"
elif [ -x /usr/bin/axisos-settings-panel ]; then
    exec /usr/bin/axisos-settings-panel "$@"
else
    exec python3 @AXIS_DIR@/settings.py "$@"
fi
