    def init_processes_tab(self):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)

        # [PID(int), Name(str), CPU(float), Mem(float), User(str), MemMB(str)]
        self.proc_store = Gtk.ListStore(int, str, float, float, str, str)
        self.proc_tree = Gtk.TreeView(model=self.proc_store)
        self.proc_tree.connect("cursor-changed", self.on_process_selected)
        self.proc_tree.set_rules_hint(True)

        cols = [
            ("PID", 0, 70),
            ("Process Name", 1, 280),
            ("CPU %", 2, 85),
            ("Memory %", 3, 85),
            ("Memory (MB)", 5, 110),
            ("User", 4, 100)
        ]
        for title, idx, width in cols:
            renderer = Gtk.CellRendererText()
            col = Gtk.TreeViewColumn(title, renderer, text=idx)
            col.set_min_width(width)
            col.set_sort_column_id(idx)
            self.proc_tree.append_column(col)

        scroll.add(self.proc_tree)
        self.notebook.append_page(scroll, Gtk.Label(label="Processes"))

