class TelemetryGraph(Gtk.DrawingArea):
    def __init__(self, color_hex="#87cf3e", max_points=60):
        super().__init__()
        self.max_points = max_points
        self.data = [0.0] * max_points
        self.color_hex = color_hex
        self.set_size_request(-1, 110)
        self.connect("draw", self.on_draw)

    def add_point(self, val):
        self.data.pop(0)
        self.data.append(min(100.0, max(0.0, float(val))))
        self.queue_draw()

    def on_draw(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()

        # Canvas background (Mint Charcoal #121814)
        cr.set_source_rgb(0.07, 0.09, 0.08)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        # Grid guidelines
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.06)
        cr.set_line_width(1.0)
        for y in range(0, height, 25):
            cr.move_to(0, y)
            cr.line_to(width, y)
            cr.stroke()

        if not self.data:
            return

        r = int(self.color_hex[1:3], 16) / 255.0
        g = int(self.color_hex[3:5], 16) / 255.0
        b = int(self.color_hex[5:7], 16) / 255.0

        step = width / (self.max_points - 1)

        # Gradient fill
        cr.move_to(0, height)
        for i, val in enumerate(self.data):
            x = i * step
            y = height - (val / 100.0) * height
            cr.line_to(x, y)
        cr.line_to(width, height)
        cr.close_path()

        cr.set_source_rgba(r, g, b, 0.18)
        cr.fill()

        # Line plot
        cr.move_to(0, height - (self.data[0] / 100.0) * height)
        for i, val in enumerate(self.data):
            x = i * step
            y = height - (val / 100.0) * height
            cr.line_to(x, y)

        cr.set_source_rgb(r, g, b)
        cr.set_line_width(2.0)
        cr.stroke()

class TaskManagerApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Task Manager - AxisOS")
        self.set_default_size(1000, 680)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.apply_custom_styling()

        # Root vertical box
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_vbox)

        # 1. Classic MenuBar (X-Apps philosophy)
        menubar = self.create_menubar()
        main_vbox.pack_start(menubar, False, False, 0)

        # 2. Dedicated ToolBar (X-Apps philosophy)
        toolbar = self.create_toolbar()
        main_vbox.pack_start(toolbar, False, False, 0)

        # 3. Main Notebook (Processes, Performance, Services)
        self.notebook = Gtk.Notebook()
        self.notebook.set_margin_top(4)
        self.notebook.set_margin_bottom(4)
        self.notebook.set_margin_start(6)
        self.notebook.set_margin_end(6)
        main_vbox.pack_start(self.notebook, True, True, 0)

        self.init_processes_tab()
        self.init_performance_tab()
        self.init_services_tab()

        # 4. Classic StatusBar (X-Apps philosophy)
        self.statusbar = Gtk.Statusbar()
        self.statusbar_ctx = self.statusbar.get_context_id("main")
        main_vbox.pack_end(self.statusbar, False, False, 0)

        # Telemetry State
        self.last_cpu_times = None
        self.refresh_interval_ms = 1000
        self.timer_id = GLib.timeout_add(self.refresh_interval_ms, self.update_telemetry)

