#!/bin/sh
if [ "$1" = "about" ] || [ "$1" = "--about" ] || [ "$1" = "-a" ]; then
    exec /usr/local/bin/axisos-settings-panel about
elif [ "$1" = "updates" ] || [ "$1" = "--updates" ] || [ "$1" = "-u" ]; then
    exec /usr/local/bin/axisos-settings-panel updates
fi
exec /usr/local/bin/axisos-settings-panel "$@"
