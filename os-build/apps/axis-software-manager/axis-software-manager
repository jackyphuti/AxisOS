class SoftwareApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Software Manager - AxisOS")
        self.set_default_size(1020, 700)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Apply Mint-Y / X-App CSS Styling
        self.apply_custom_styling()

        # Root vertical box
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_vbox)

        # 1. Classic MenuBar (X-Apps philosophy)
        menubar = self.create_menubar()
        main_vbox.pack_start(menubar, False, False, 0)

        # 2. Dedicated ToolBar (X-Apps philosophy)
        toolbar = self.create_toolbar()
        main_vbox.pack_start(toolbar, False, False, 0)

        # 3. Main Workspace Area (Paned: Categories Sidebar + Content Stack)
        self.paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.paned.set_position(230)
        main_vbox.pack_start(self.paned, True, True, 0)

        # Left Sidebar: Categories
        sidebar_frame = Gtk.Frame()
        sidebar_frame.set_shadow_type(Gtk.ShadowType.IN)
        sidebar_frame.set_margin_top(6)
        sidebar_frame.set_margin_bottom(6)
        sidebar_frame.set_margin_start(6)
        sidebar_frame.set_margin_end(3)

        self.category_list = Gtk.ListBox()
        self.category_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.category_list.connect("row-selected", self.on_category_selected)

        categories = [
            ("All Applications", "applications-other"),
            ("Development", "applications-development"),
            ("Gaming", "applications-games"),
            ("Internet", "applications-internet"),
            ("Multimedia", "applications-multimedia"),
            ("System", "applications-system"),
            ("Installed", "emblem-default")
        ]

        for cat_name, icon_name in categories:
            row = Gtk.ListBoxRow()
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            hbox.set_margin_top(8)
            hbox.set_margin_bottom(8)
            hbox.set_margin_start(12)
            hbox.set_margin_end(12)

            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
            lbl = Gtk.Label(label=cat_name, xalign=0)
            lbl.get_style_context().add_class("cat-title")

            hbox.pack_start(img, False, False, 0)
            hbox.pack_start(lbl, True, True, 0)
            row.add(hbox)
            self.category_list.add(row)

        sidebar_scroll = Gtk.ScrolledWindow()
        sidebar_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_scroll.add(self.category_list)
        sidebar_frame.add(sidebar_scroll)
        self.paned.pack1(sidebar_frame, False, False)

        # Right View: Stack (Grid of Cards vs Detail View)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)

        # Page 1: FlowGrid of Software Cards
        scroll_grid = Gtk.ScrolledWindow()
        scroll_grid.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll_grid.set_margin_top(6)
        scroll_grid.set_margin_bottom(6)
        scroll_grid.set_margin_start(3)
        scroll_grid.set_margin_end(6)

        self.grid = Gtk.FlowBox()
        self.grid.set_valign(Gtk.Align.START)
        self.grid.set_max_children_per_line(3)
        self.grid.set_selection_mode(Gtk.SelectionMode.NONE)
        self.grid.set_homogeneous(True)
        self.grid.set_row_spacing(12)
        self.grid.set_column_spacing(12)
        self.grid.set_margin_top(8)
        self.grid.set_margin_bottom(8)
        self.grid.set_margin_start(8)
        self.grid.set_margin_end(8)
        scroll_grid.add(self.grid)
        self.stack.add_named(scroll_grid, "grid_view")

        # Page 2: Detailed App View
        self.detail_container = Gtk.ScrolledWindow()
        self.detail_container.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.stack.add_named(self.detail_container, "detail_view")

        self.paned.pack2(self.stack, True, True)

        # 4. Classic StatusBar (X-Apps philosophy)
        self.statusbar = Gtk.Statusbar()
        self.statusbar_ctx = self.statusbar.get_context_id("main")
        main_vbox.pack_end(self.statusbar, False, False, 0)

        # State Variables
        self.current_category = "All Applications"
        self.current_search = ""
        self.detect_installed_packages()
        self.populate_apps()

        # Select first category
        self.category_list.select_row(self.category_list.get_row_at_index(0))
        self.update_statusbar(f"Ready. {len(SOFTWARE_CATALOG)} applications available across Debian APT and Flathub.")

