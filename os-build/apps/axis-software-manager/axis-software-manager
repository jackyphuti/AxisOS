    def create_toolbar(self):
        toolbar = Gtk.Toolbar()
        toolbar.set_style(Gtk.ToolbarStyle.BOTH_HORIZ)

        # Back Button (for returning from detailed view)
        self.btn_back = Gtk.ToolButton.new_from_stock(Gtk.STOCK_GO_BACK)
        self.btn_back.set_label("Back")
        self.btn_back.set_sensitive(False)
        self.btn_back.connect("clicked", lambda b: self.switch_to_grid())
        toolbar.insert(self.btn_back, -1)

        # Refresh Tool Button
        btn_refresh = Gtk.ToolButton.new_from_stock(Gtk.STOCK_REFRESH)
        btn_refresh.set_label("Refresh")
        btn_refresh.connect("clicked", lambda b: self.refresh_repositories())
        toolbar.insert(btn_refresh, -1)

        # Separator
        toolbar.insert(Gtk.SeparatorToolItem(), -1)

        # Installed Filter Toggle
        btn_installed = Gtk.ToolButton.new_from_stock(Gtk.STOCK_APPLY)
        btn_installed.set_label("Installed")
        btn_installed.connect("clicked", lambda b: self.select_category_by_name("Installed"))
        toolbar.insert(btn_installed, -1)

        # Expanding Separator
        sep_expand = Gtk.SeparatorToolItem()
        sep_expand.set_draw(False)
        sep_expand.set_expand(True)
        toolbar.insert(sep_expand, -1)

        # Search Entry in ToolBar
        tool_item_search = Gtk.ToolItem()
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search packages...")
        self.search_entry.set_width_chars(28)
        self.search_entry.connect("search-changed", self.on_search_changed)
        tool_item_search.add(self.search_entry)
        toolbar.insert(tool_item_search, -1)

        return toolbar

    def update_statusbar(self, message):
        self.statusbar.pop(self.statusbar_ctx)
        self.statusbar.push(self.statusbar_ctx, message)

    def detect_installed_packages(self):
        for app in SOFTWARE_CATALOG:
            binary = app.get("exec", "").split()[0]
            if subprocess.run(["which", binary], capture_output=True).returncode == 0:
                app["installed"] = True
            elif "Flatpak" in app.get("source", ""):
                f_check = subprocess.run(["flatpak", "info", app["pkg_target"]], capture_output=True)
                app["installed"] = (f_check.returncode == 0)

    def populate_apps(self):
        for child in self.grid.get_children():
            self.grid.remove(child)

        count = 0
        for app in SOFTWARE_CATALOG:
            if self.current_category == "Installed" and not app["installed"]:
                continue
            elif self.current_category not in ("All Applications", "Installed") and app["category"] != self.current_category:
                continue

            if self.current_search:
                q = self.current_search.lower()
                if q not in app["name"].lower() and q not in app["tagline"].lower() and q not in app["category"].lower():
                    continue

            card = self.create_app_card(app)
            self.grid.add(card)
            count += 1

        self.grid.show_all()
        self.update_statusbar(f"Showing {count} applications in '{self.current_category}'.")

    def create_app_card(self, app):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.get_style_context().add_class("app-card")
        box.set_size_request(250, 165)

        # Header: Icon + Title + Version
        top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        icon = Gtk.Image.new_from_icon_name(app["icon"], Gtk.IconSize.DND)
        top_row.pack_start(icon, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label=app["name"], xalign=0)
        title.get_style_context().add_class("app-title")
        title.set_ellipsize(Pango.EllipsizeMode.END)
        title_box.pack_start(title, False, False, 0)

        badge_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        badge = Gtk.Label(label=app["source"], xalign=0)
        badge.get_style_context().add_class("source-badge")
        badge_box.pack_start(badge, False, False, 0)

        ver_lbl = Gtk.Label(label=f"v{app.get('version', '1.0')}", xalign=0)
        ver_lbl.get_style_context().add_class("app-tagline")
        badge_box.pack_start(ver_lbl, False, False, 0)

        title_box.pack_start(badge_box, False, False, 0)
        top_row.pack_start(title_box, True, True, 0)
        box.pack_start(top_row, False, False, 0)

        # Tagline
        desc = Gtk.Label(label=app["tagline"], xalign=0)
        desc.set_line_wrap(True)
        desc.set_lines(2)
        desc.set_ellipsize(Pango.EllipsizeMode.END)
        desc.get_style_context().add_class("app-tagline")
        box.pack_start(desc, True, True, 0)

        # Action Buttons (Details + Install/Remove)
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        details_btn = Gtk.Button(label="Details")
        details_btn.connect("clicked", lambda b, a=app: self.show_app_details(a))
        btn_box.pack_start(details_btn, True, True, 0)

        if app["installed"]:
            remove_btn = Gtk.Button(label="Remove")
            remove_btn.get_style_context().add_class("action-remove")
            remove_btn.connect("clicked", lambda b, a=app: self.install_or_remove(a, action="remove"))
            btn_box.pack_start(remove_btn, False, False, 0)
        else:
            install_btn = Gtk.Button(label="Install")
            install_btn.get_style_context().add_class("action-install")
            install_btn.connect("clicked", lambda b, a=app: self.install_or_remove(a, action="install"))
            btn_box.pack_start(install_btn, False, False, 0)

        box.pack_end(btn_box, False, False, 0)
        return box

