        header_row.pack_start(info_box, True, True, 0)

        # Action Buttons in detail view
        action_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        if app["installed"]:
            launch_btn = Gtk.Button(label="Launch Application")
            launch_btn.connect("clicked", lambda b: self.launch_app(app))
            action_box.pack_start(launch_btn, False, False, 0)

            rem_btn = Gtk.Button(label="Uninstall")
            rem_btn.get_style_context().add_class("action-remove")
            rem_btn.connect("clicked", lambda b: self.install_or_remove(app, action="remove"))
            action_box.pack_start(rem_btn, False, False, 0)
        else:
            inst_btn = Gtk.Button(label="Install Application")
            inst_btn.get_style_context().add_class("action-install")
            inst_btn.connect("clicked", lambda b: self.install_or_remove(app, action="install"))
            action_box.pack_start(inst_btn, False, False, 0)

        header_row.pack_end(action_box, False, False, 0)
        vbox.pack_start(header_row, False, False, 0)

        # Separator
        vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        # Description
        desc_title = Gtk.Label(label="Description", xalign=0)
        desc_title.set_markup("<b>Description</b>")
        vbox.pack_start(desc_title, False, False, 0)

        desc_body = Gtk.Label(label=app.get("description", app["tagline"]), xalign=0)
        desc_body.set_line_wrap(True)
        vbox.pack_start(desc_body, False, False, 0)

        self.detail_container.add(vbox)
        self.detail_container.show_all()

        # Switch to detail stack page
        self.btn_back.set_sensitive(True)
        self.stack.set_visible_child_name("detail_view")
        self.update_statusbar(f"Viewing details for {app['name']}.")

    def switch_to_grid(self):
        self.btn_back.set_sensitive(False)
        self.stack.set_visible_child_name("grid_view")
        self.update_statusbar(f"Returned to catalog view.")

    def on_category_selected(self, listbox, row):
        if row:
            box = row.get_child()
            lbl = box.get_children()[1]
            self.current_category = lbl.get_text()
            self.switch_to_grid()
            self.populate_apps()

    def select_category_by_name(self, name):
        self.current_category = name
        self.switch_to_grid()
        self.populate_apps()

    def on_search_changed(self, entry):
        self.current_search = entry.get_text().strip()
        self.switch_to_grid()
        self.populate_apps()

    def launch_app(self, app):
        cmd = app.get("exec", "")
        if cmd:
            subprocess.Popen(cmd.split())

    def install_or_remove(self, app, action="install"):
        self.update_statusbar(f"{'Installing' if action=='install' else 'Removing'} {app['name']} via {app['source']}...")

        def worker():
            pkg = app["pkg_target"]
            source = app["source"]
            if "Flatpak" in source:
                cmd = ["flatpak", "install" if action == "install" else "uninstall", "-y", pkg if action != "install" else "flathub", pkg] if action == "install" else ["flatpak", "uninstall", "-y", pkg]
            else:
                cmd = ["sudo", "axis", "install"] + pkg.split() if action == "install" else ["sudo", "apt-get", "remove", "-y"] + pkg.split()

            proc = subprocess.run(cmd, capture_output=True, text=True)
            success = (proc.returncode == 0)

            def done():
                app["installed"] = (action == "install" and success)
                self.update_statusbar(f"{app['name']} {'installed' if action=='install' else 'removed'} successfully." if success else f"Error: failed to {action} {app['name']}.")
                self.populate_apps()
                if self.stack.get_visible_child_name() == "detail_view":
                    self.show_app_details(app)

            GLib.idle_add(done)

        threading.Thread(target=worker, daemon=True).start()

    def refresh_repositories(self):
        self.update_statusbar("Synchronizing APT indices and Flathub remotes...")
        def worker():
            subprocess.run(["sudo", "apt-get", "update"], capture_output=True)
            if subprocess.run(["which", "flatpak"], capture_output=True).returncode == 0:
                subprocess.run(["flatpak", "update", "--appstream"], capture_output=True)
            def done():
                self.update_statusbar("Repositories successfully synchronized.")
                self.populate_apps()
            GLib.idle_add(done)
        threading.Thread(target=worker, daemon=True).start()

    def on_install_local_deb(self, widget):
        chooser = Gtk.FileChooserDialog(
            title="Select Debian Package to Install",
            parent=self,
            action=Gtk.FileChooserAction.OPEN
        )
        chooser.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        filter_deb = Gtk.FileFilter()
        filter_deb.set_name("Debian packages (*.deb)")
        filter_deb.add_pattern("*.deb")
        chooser.add_filter(filter_deb)

        if chooser.run() == Gtk.ResponseType.OK:
            filename = chooser.get_filename()
            chooser.destroy()
            self.update_statusbar(f"Installing {filename} via dpkg/apt...")
            def worker():
                proc = subprocess.run(["sudo", "axis", "install", filename], capture_output=True, text=True)
                def done():
                    self.update_statusbar(f"Finished installing {os.path.basename(filename)}.")
                    self.populate_apps()
                GLib.idle_add(done)
            threading.Thread(target=worker, daemon=True).start()
        else:
            chooser.destroy()

