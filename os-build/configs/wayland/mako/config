# Nobara Linux Notification Styling
font=Inter 11
background-color=#12161af0
text-color=#ffffff
border-color=#e53935
border-size=2
border-radius=8
padding=12
margin=14
default-timeout=5000
icons=1
max-icon-size=48

[urgency=low]
border-color=#3b82f6

[urgency=normal]
border-color=#e53935

[urgency=critical]
border-color=#ef4444
default-timeout=0
