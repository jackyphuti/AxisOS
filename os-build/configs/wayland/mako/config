# AxisOS Unified One UI Notification Styling
font=IBM Plex Sans 11
background-color=#1F2231f2
text-color=#F2F3F7
border-color=#2E3349
border-size=1
border-radius=16
padding=14
margin=16
default-timeout=5000
icons=1
max-icon-size=48

[urgency=low]
border-color=#2E3349

[urgency=normal]
border-color=#7D95FF

[urgency=critical]
border-color=#F43F5E
default-timeout=0
