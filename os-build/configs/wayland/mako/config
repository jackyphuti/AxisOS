# AxisOS Linux Notification Styling
font=Inter 11
background-color=#0a0c10f0
text-color=#ffffff
border-color=#2563eb
border-size=2
border-radius=8
padding=12
margin=14
default-timeout=5000
icons=1
max-icon-size=48

[urgency=low]
border-color=#60a5fa

[urgency=normal]
border-color=#2563eb

[urgency=critical]
border-color=#ef4444
default-timeout=0
