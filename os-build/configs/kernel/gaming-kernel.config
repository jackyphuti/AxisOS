# ==============================================================================
# AxisOS PlayStation & High-Performance Gaming Kernel Configuration Fragment
# Targeted for: AMD RDNA2/3/4, Intel Arc (Alchemist/Battlemage), NVIDIA Turing/Ampere/Ada
# ==============================================================================

# 1. Low-Latency Preemption & High-Precision Timer Subsystem
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_COMMON=y
CONFIG_RCU_FAST_NO_HZ=y
CONFIG_TICK_ONESHOT=y

# 2. Modern Wine/Proton & Emulator Synchronization (ntsync / winesync)
CONFIG_NTSYNC=m

# 3. Memory & Virtualization Optimizations (Proton, RPCS3, PCSX2, shadPS4)
CONFIG_USERFAULTFD=y
CONFIG_MEMCG=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m

# 4. AMD Radeon GPU Drivers (Modern RDNA, GCN, APU)
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
CONFIG_DRM_AMD_DC_DCN=y
CONFIG_HSA_AMD=y

# 5. Intel GPU Drivers (Intel Arc Alchemist / Battlemage & Xe Graphics)
CONFIG_DRM_I915=m
CONFIG_DRM_I915_CAPTURE_ERROR=y
CONFIG_DRM_XE=m
CONFIG_DRM_XE_DISPLAY=y

# 6. NVIDIA GPU Base & Open Kernel Module Interface
CONFIG_DRM_NOUVEAU=m
CONFIG_FB_EFI=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y

# 7. PlayStation, Xbox & Universal Gamepad Input Subsystem
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_BT_HIDP=m

# 8. CPU Frequency Governors & Power Delivery
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_UT=y
