[Desktop Entry]
Name=Settings
Comment=AxisOS System Settings — GNOME Control Center + AxisOS Features
Exec=gnome-control-center
Icon=preferences-system
Terminal=false
Type=Application
Categories=GNOME;GTK;Settings;DesktopSettings;HardwareSettings;X-GNOME-Settings-Panel;X-GNOME-PersonalSettings;X-GNOME-SystemSettings;
Keywords=Appearance;Theme;Display;Taskbar;Update;WiFi;Password;Time;Health;Gaming;Biometrics;Iris;Fingerprint;Rewind;USB;
StartupNotify=true
Actions=AxisHealth;AxisGaming;AxisBiometrics;AxisSignature;AxisAppearance;AxisUpdates;

[Desktop Action AxisHealth]
Name=System Health Check
Exec=/usr/local/bin/axisos-settings-panel health
Icon=utilities-system-monitor

[Desktop Action AxisGaming]
Name=Gaming Boost & Hardware
Exec=/usr/local/bin/axisos-settings-panel gaming
Icon=input-gaming

[Desktop Action AxisBiometrics]
Name=Biometrics & Screen Lock
Exec=/usr/local/bin/axisos-settings-panel security
Icon=changes-prevent

[Desktop Action AxisSignature]
Name=AxisOS Signature Features
Exec=/usr/local/bin/axisos-settings-panel signature
Icon=emblem-system

[Desktop Action AxisAppearance]
Name=Taskbar & Appearance
Exec=/usr/local/bin/axisos-settings-panel appearance
Icon=preferences-desktop-theme

[Desktop Action AxisUpdates]
Name=Software Updates
Exec=/usr/local/bin/axisos-settings-panel updates
Icon=software-update-available
