[Desktop Entry]
Name=System Health Check
Comment=Check disk space, memory, network, and system services health
Exec=/usr/local/bin/axisos-settings-panel health
Icon=utilities-system-monitor
Terminal=false
Type=Application
NoDisplay=true
Categories=GNOME;GTK;Settings;X-GNOME-Settings-Panel;X-GNOME-SystemSettings;
OnlyShowIn=GNOME;
Keywords=Health;Diagnostic;Check;Status;Storage;Memory;Services;System;
