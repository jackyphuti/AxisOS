# ==============================================================================
# AxisOS Universal Gamepad, Controller & uinput Rules
# Fully compliant with Steam Devices, SDL2, Proton, RetroArch, PCSX2, RPCS3
# ==============================================================================

# Joystick & event device nodes
KERNEL=="js[0-9]*", MODE="0666", TAG+="uaccess"
KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0666", TAG+="uaccess"

# Universal uinput for virtual controllers, emulated inputs, and SDL2 mapping
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", MODE="0660", GROUP="input", TAG+="uaccess"

# Sony DualShock 3, 4 and DualSense / Edge (USB & Bluetooth)
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", MODE="0666", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0666", TAG+="uaccess"

# Microsoft Xbox 360, One, Series X/S Controllers (USB, Dongle, Bluetooth / xpadneo)
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="045e", MODE="0666", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02e0", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02fd", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b12", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b13", MODE="0666", TAG+="uaccess"

# Valve Steam Controller, Steam Deck & Virtual Pad
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="28de", MODE="0666", GROUP="plugdev", TAG+="uaccess"
KERNEL=="uinput", ATTRS{name}=="Steam Controller*", MODE="0660", GROUP="input", TAG+="uaccess"

# Nintendo Switch Pro Controller and Joy-Cons
KERNEL=="hidraw*", ATTRS{idVendor}=="057e", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="057e", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# Generic Bluetooth Gamepads
SUBSYSTEM=="input", ATTRS{name}=="*Controller*", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="*Gamepad*", MODE="0666", TAG+="uaccess"
