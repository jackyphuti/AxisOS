[Unit]
Description=AxisOS Game Mode Session (gamescope)
After=live-config.service systemd-user-sessions.service user-runtime-dir@1000.service user@1000.service seatd.service systemd-logind.service
Wants=user-runtime-dir@1000.service user@1000.service seatd.service systemd-logind.service
Conflicts=sddm.service axisos.service getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=axis
Group=axis
PAMName=axisos-autologin
WorkingDirectory=/home/axis
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=gamescope:Steam
Environment=SDL_VIDEODRIVER=wayland
Environment=GDK_BACKEND=wayland
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=+/bin/sh -c 'mkdir -p /run/user/1000 && chown 1000:1000 /run/user/1000 2>/dev/null && chmod 0700 /run/user/1000 2>/dev/null || true'
ExecStart=/usr/local/bin/axisos-gamemode-session.sh
Restart=no
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1

[Install]
WantedBy=graphical.target
