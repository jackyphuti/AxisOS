[Unit]
Description=AxisOS Boot Success Confirmation Service
Documentation=man:axis-update(8)
After=multi-user.target graphical.target
ConditionPathExists=/usr/bin/axis-update

[Service]
Type=oneshot
ExecStart=/usr/bin/axis-update mark-successful
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
